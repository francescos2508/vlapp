rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /recipes/{recipeId} {
      allow read, delete: if signedIn()
        && resource.data.userid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userid == request.auth.uid
        && request.resource.data.userid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, delete: if signedIn()
        && resource.data.firebaseUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.firebaseUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['password']);

      allow update: if signedIn()
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['password']);
    }

    match /userProfiles/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.firebaseUid == request.auth.uid;

      allow delete: if signedIn()
        && userId == request.auth.uid;
    }

    match /sharedRecipes/{documentId} {
      allow read: if signedIn()
        && (
          resource.data.senderid == request.auth.uid
          || resource.data.receiverid == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.senderid == request.auth.uid
        && request.resource.data.receiverid is string;

      allow update: if signedIn()
        && (
          resource.data.senderid == request.auth.uid
          || resource.data.receiverid == request.auth.uid
        )
        && request.resource.data.senderid == resource.data.senderid
        && request.resource.data.receiverid == resource.data.receiverid;

      allow delete: if signedIn()
        && (
          resource.data.senderid == request.auth.uid
          || resource.data.receiverid == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}